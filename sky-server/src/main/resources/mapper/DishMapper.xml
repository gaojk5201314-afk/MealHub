<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.DishMapper">
    <insert id="insertdish" parameterType="com.sky.entity.Dish" useGeneratedKeys="true" keyProperty="id">
        insert into dish (category_id, name, image, price, description, status)
        values (#{categoryId}, #{name}, #{image}, #{price}, #{description}, #{status})
    </insert>
    <insert id="insertflavor" parameterType="java.util.List">
        insert into dish_flavor (dish_id, name, value) values
        <foreach collection="flavors" item="item"  separator=",">
            (#{item.dishId}, #{item.name}, #{item.value})
        </foreach>
    </insert>
    <select id="SelectAll" parameterType="com.sky.dto.DishPageQueryDTO" resultType="com.sky.vo.DishVO">
        select d.* , c.name as categoryName  from dish d left join category c on d.category_id = c.id
        <where>
            <if test="categoryId != null">
                d.category_id = #{categoryId}
            </if>
            <if test="status != null">
                d.status = #{status}
            </if>
            <if test="name != null">
                d.name like concat('%', #{name}, '%')
            </if>
        </where>
        order by d.create_time desc
    </select>
    <select id="SelectById" parameterType="java.lang.Long" resultType="com.sky.entity.Dish">
        select * from dish where id = #{id}
    </select>
    <update id="update" parameterType="com.sky.entity.Dish">
        update dish
        <set>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="name != null">name = #{name},</if>
            <if test="image != null">image = #{image},</if>
            <if test="price != null">price = #{price},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateUser != null">update_user = #{updateUser}</if>
        </set>
        where id = #{id}
    </update>
    <delete id="deletedishById" parameterType="java.util.List">
        delete from dish where id in
            <foreach collection="ids" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
    </delete>
    <select id="SelectDish" parameterType="java.util.List" resultType="com.sky.entity.SetmealDish">
        select setmeal_id from setmeal_dish where dish_id in
            <foreach collection="ids" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
    </select>
    <select id="SelectByDishId" parameterType="java.lang.Long" resultType="com.sky.entity.Dish">
        select * from dish where id = #{id}
    </select>
    <delete id="deletedishFlavorById" parameterType="java.util.List">
        delete from dish_flavor where dish_id in
            <foreach collection="ids" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
    </delete>
    <select id="selectFlavorsByDishId" parameterType="java.lang.Long" resultType="com.sky.entity.DishFlavor">
        select * from dish_flavor where dish_id = #{dishId}
    </select>
    <select id="list" resultType="Dish" parameterType="Dish">
        select * from dish
        <where>
            <if test="name != null">
                and name like concat('%',#{name},'%')
            </if>
            <if test="categoryId != null">
                and category_id = #{categoryId}
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>
    <select id="countByMap" resultType="java.lang.Integer">
        select count(id) from dish
        <where>
            <if test="status != null"> and status = #{status} </if>
            <if test="categoryId != null"> and category_id = #{categoryId} </if>
        </where>
    </select>
</mapper>