<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.MealMapper">

    <!-- 套餐VO结果映射，处理一对多关系 -->
    <resultMap id="SetmealVOResultMap" type="com.sky.vo.SetmealVO">
        <id property="id" column="id"/>
        <result property="categoryId" column="category_id"/>
        <result property="name" column="name"/>
        <result property="price" column="price"/>
        <result property="status" column="status"/>
        <result property="description" column="description"/>
        <result property="image" column="image"/>
        <result property="updateTime" column="update_time"/>
        <result property="categoryName" column="category_name"/>
        <!-- 套餐菜品关联关系 -->
        <collection property="setmealDishes" ofType="com.sky.entity.SetmealDish">
            <id property="id" column="sd_id"/>
            <result property="setmealId" column="setmeal_id"/>
            <result property="dishId" column="dish_id"/>
            <result property="name" column="sd_name"/>
            <result property="price" column="sd_price"/>
            <result property="copies" column="copies"/>
        </collection>
    </resultMap>

    <insert id="insert" parameterType="com.sky.dto.SetmealDTO" useGeneratedKeys="true" keyProperty="id">
        insert into setmeal (name, price, image, category_id, status)
        values (#{name}, #{price}, #{image}, #{categoryId}, #{status})
    </insert>
    <select id="selectList" parameterType="com.sky.dto.SetmealPageQueryDTO" resultType="com.sky.vo.SetmealVO">
        select sm.* , c.name as categoryName
        from setmeal sm left join category c on sm.category_id = c.id
        <where>
            <if test="categoryId != null and categoryId!=0">
                and sm.category_id = #{categoryId}
            </if>
            <if test="name != null and name!=''">
                and sm.name like concat('%', #{name}, '%')
            </if>
            <if test="status != null">
                and sm.status = #{status}
            </if>
        </where>
        order by id desc
    </select>
    <delete id="deleteById" parameterType="java.lang.Long">
        delete from setmeal where id = #{ids}
    </delete>
    <select id="selectById" parameterType="java.lang.Long" resultMap="SetmealVOResultMap">
        select sm.* ,
               c.name as category_name,
               sd.id as sd_id,
               sd.setmeal_id,
               sd.dish_id,
               sd.name as sd_name,
               sd.price as sd_price,
               sd.copies
        from setmeal sm
        left join category c on sm.category_id = c.id
        left join setmeal_dish sd on sm.id = sd.setmeal_id
        where sm.id = #{id}
        order by sd.id
    </select>
    <update id="update" parameterType="com.sky.dto.SetmealDTO">
        update setmeal
        <set>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="price != null">
                price = #{price},
            </if>
            <if test="image != null and image != ''">
                image = #{image},
            </if>
            <if test="categoryId != null and categoryId!=0">
                category_id = #{categoryId},
            </if>
        </set>
        where id = #{id}
    </update>
    <!-- 删除套餐菜品关系 -->
    <delete id="deleteSetmealDish" parameterType="java.lang.Long">
        delete from setmeal_dish where setmeal_id = #{setmealId}
    </delete>
    <!-- 批量插入套餐菜品关系 -->
    <insert id="insertSetmealDish" parameterType="java.util.List">
        insert into setmeal_dish
        (setmeal_id,dish_id,name,price,copies)
        values
        <foreach collection="setmealDishes" item="sd" separator=",">
            (#{sd.setmealId},#{sd.dishId},#{sd.name},#{sd.price},#{sd.copies})
        </foreach>
    </insert>
    <!-- 更新套餐状态（单个） -->
    <update id="updateStatus">
        update setmeal
        set status = #{status}
        where id = #{id}
    </update>
    <!-- 更新套餐菜品状态 -->
    <update id="updateDishStatus">
        update setmeal_dish
        set status = #{status}
        where setmeal_id in <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </update>
</mapper>