<view class="ai-chat-container">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <image class="nav-back-icon" src="/static/btn_back.png" mode="aspectFit"></image>
    </view>
    <view class="nav-title">AI助手</view>
  </view>
  <scroll-view class="message-list" scroll-y="true" scroll-with-animation="true" scroll-into-view="{{scrollToId}}">
    <block wx:if="{{messages.length === 0}}">
      <view class="welcome-tip">
        <view class="icon">🤖</view>
        你好！我是AI助手
        有什么可以帮助你的吗？
      </view>
    </block>
    <block wx:for="{{messages}}" wx:for-item="msg" wx:for-index="index" wx:key="index">
      <view class="message-item {{msg.role}}">
        <block wx:if="{{msg.role === 'ai'}}">
          <view class="avatar ai-avatar">AI</view>
        </block>
        <view class="bubble">{{msg.content}}</view>
        <block wx:if="{{msg.role === 'user'}}">
          <view class="avatar user-avatar">我</view>
        </block>
      </view>
    </block>
    <block wx:if="{{loading}}">
      <view class="message-item ai">
        <view class="avatar ai-avatar">AI</view>
        <view class="bubble">
          <view class="loading-tip">思考中...</view>
        </view>
      </view>
    </block>
    <view id="msg-end"></view>
  </scroll-view>
  <view class="input-area">
    <input class="input-box" type="text" placeholder="请输入您的问题..." value="{{inputValue}}" bindinput="onInput" bindconfirm="sendMessage" confirm-type="send" />
    <view class="send-btn {{inputValue.trim() === '' ? 'disabled' : ''}}" bindtap="sendMessage">发送</view>
  </view>
</view>