page {
  background-color: #f5f5f5;
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.ai-chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100%;
}
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #E95F3C;
  display: flex;
  align-items: center;
  padding-top: 40rpx;
  height: 88rpx;
}
.nav-back {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-icon {
  width: 48rpx;
  height: 48rpx;
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 500;
  padding-right: 88rpx;
}
.message-list {
  flex: 1;
  padding: 140rpx 20rpx 120rpx;
  overflow-y: scroll;
  -webkit-overflow-scrolling: touch;
}
.message-item {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}
.message-item.user {
  justify-content: flex-end;
}
.message-item.ai {
  justify-content: flex-start;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.user-avatar {
  margin-left: 16rpx;
  background-color: #E95F3C;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}
.ai-avatar {
  margin-right: 16rpx;
  background-color: #07c160;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}
.bubble {
  max-width: 520rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}
.user .bubble {
  background-color: #E95F3C;
  color: #ffffff;
  border-bottom-right-radius: 4rpx;
}
.ai .bubble {
  background-color: #ffffff;
  color: #333333;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}
.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #ffffff;
  border-top: 1rpx solid #e8e8e8;
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  padding-bottom: 30rpx;
}
.input-box {
  flex: 1;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333;
}
.send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background-color: #E95F3C;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 36rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.send-btn:active {
  opacity: 0.8;
}
.send-btn.disabled {
  background-color: #cccccc;
}
.loading-tip {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 26rpx;
}
.welcome-tip {
  text-align: center;
  padding: 60rpx 40rpx;
  color: #999;
  font-size: 28rpx;
  line-height: 1.8;
}
.welcome-tip .icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}